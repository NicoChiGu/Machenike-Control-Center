{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Machenike L16W Center",
  "version": "1.0.0",
  "identifier": "com.machenike.l16wcenter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MACHENIKE 智能控制中心 (现代化版)",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "osd",
        "title": "Machenike OSD",
        "width": 340,
        "height": 110,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/WTIOportDrv.sys"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/installer_hooks.nsh"
      }
    }
  }
}
